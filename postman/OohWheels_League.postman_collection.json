{
  "info": {
    "_postman_id": "a9b8c7d6-1234-4567-89ab-cdef01234567",
    "name": "OohWheels - League Section API",
    "description": "Complete Postman collection for testing the OohWheels Weekly League Leaderboard. Powers the Weekly League Banner (Gold tier, 2d 14h countdown), Podium Top 3 (1st You 2150 XP, 2nd Aisha K. 1840 XP, 3rd Ravi P. 1320 XP), Rankings 4-7+ (Layla H., Sara M., Omar N., Tom B.), League Progression Tiers, and Head-to-Head Duels.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5020/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "friendId",
      "value": "fr_01",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Login (Obtain Token First)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.token) {",
              "        pm.collectionVariables.set(\"token\", jsonData.token);",
              "        console.log(\"✅ League Auth Token auto-saved:\", jsonData.token);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emailOrPhone\": \"learner@oohwheels.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Logs in the demo learner to get a JWT token, automatically saving it to {{token}}."
      },
      "response": []
    },
    {
      "name": "1. Get Weekly League Leaderboard (Gold Tier & Podium)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/league",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "league"
          ]
        },
        "description": "Powers the League screen: Weekly Gold League banner ('Ends in 2d 14h'), Top 3 podium (#1 You 2150 XP, #2 Aisha K. 1840 XP, #3 Ravi P. 1320 XP), and ranks 4-7+."
      },
      "response": []
    },
    {
      "name": "2. Get League Tiers & Progression Zones",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/league/tiers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "league",
            "tiers"
          ]
        },
        "description": "Returns all 6 competitive tiers (Bronze, Silver, Gold, Sapphire, Ruby, Diamond), XP thresholds, colors, and promotion requirements."
      },
      "response": []
    },
    {
      "name": "3. Start Duel with Friend",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/league/duel/{{friendId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "league",
            "duel",
            "{{friendId}}"
          ]
        },
        "description": "Starts an instant 5-question speed quiz duel challenge with a friend."
      },
      "response": []
    }
  ]
}
