          "raw": "{{baseUrl}}/practice/topics?filter=all",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "practice",
            "topics"
          ],
          "query": [
            {
              "key": "filter",
              "value": "all",
              "description": "Options: all | weak | new | saved"
            }
          ]
        },
        "description": "Lists the 8 DVSA practice topics with mastery percentages, question count, and color indicators."
      },
      "response": []
    },
