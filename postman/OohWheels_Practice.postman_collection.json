    {
      "name": "5. Start Practice Session (Step 1: Key Rule)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data.sessionId) {",
              "        pm.collectionVariables.set(\"sessionId\", jsonData.data.sessionId);",
              "        console.log(\"✅ Practice Session ID auto-saved:\", jsonData.data.sessionId);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"topicKey\": \"road-signs\",\n  \"questionCount\": 10,\n  \"instantFeedback\": true,\n  \"includeVideos\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/practice/start",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "practice",
            "start"
          ]
        },
        "description": "Initializes an interactive practice drill. Returns the Step 1 Rule of the Road text & audio url, and auto-saves {{sessionId}} for subsequent steps."
      },
      "response": []
    },
    {
