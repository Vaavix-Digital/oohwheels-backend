{
  "info": {
    "_postman_id": "b182d95e-1823-41bb-9428-11883390f1ea",
    "name": "OohWheels - Practice Section API",
    "description": "Complete Postman collection for testing the OohWheels Practice Section, including 8 topic drills, interactive 3-step structured practice engine, instant feedback, flash signs, video perception library, and daily challenge.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5020/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Login (Obtain Token First)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.token) {",
              "        pm.collectionVariables.set(\"token\", jsonData.token);",
              "        console.log(\"✅ Practice Auth Token auto-saved:\", jsonData.token);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emailOrPhone\": \"learner@oohwheels.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Logs in with the demo account and auto-saves the Bearer token for all practice requests in this collection."
      },
      "response": []
    },
    {
      "name": "1. Practice Home Overview",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/practice/overview",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "practice",
            "overview"
          ]
        },
        "description": "Returns the 8 practice modes cards (Practice by topic, Weak spots, Quick 10, Saved questions, Mistakes bank, Flash signs, Video library, Daily challenge) and topic mastery summary."
      },
      "response": []
    },
    {
      "name": "2. Practice Topics List (All 8 Topics)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
