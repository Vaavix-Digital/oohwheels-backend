{
  "info": {
    "_postman_id": "c71a399f-723d-4c31-90a8-e160a221f75b",
    "name": "OohWheels - Auth & User Profile API",
    "description": "Complete Postman collection for testing OohWheels driving theory authentication, password reset, and user profile gamification endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Checks if the OohWheels backend server is running and accessible."
      },
      "response": []
    },
    {
      "name": "2. Login (Demo User)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.token) {",
              "        pm.collectionVariables.set(\"token\", jsonData.token);",
              "        console.log(\"✅ Token auto-saved to collection variable:\", jsonData.token);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"learner@oohwheels.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Authenticates with default demo credentials. Saves JWT token automatically for subsequent protected requests."
      },
      "response": []
    },
    {
      "name": "3. Register New User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var randomSuffix = Math.floor(Math.random() * 100000);",
              "pm.variables.set(\"randomEmail\", \"learner_\" + randomSuffix + \"@example.com\");"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.token) {",
              "        pm.collectionVariables.set(\"token\", jsonData.token);",
              "        console.log(\"✅ Registered user token saved:\", jsonData.token);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alex Driver\",\n  \"email\": \"{{randomEmail}}\",\n  \"password\": \"password123\",\n  \"country\": \"GB\",\n  \"preferredLanguage\": \"en\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "Registers a new user account with a dynamic unique email address and initialises gamification stats."
      },
      "response": []
    },
    {
      "name": "4. Get Current User & Top Bar Stats (Protected)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "me"
          ]
        },
        "description": "Requires Authorization Bearer token. Returns user profile and Duolingo-style top bar stats: streak, gems, hearts, daily XP goal, and coach message."
      },
      "response": []
    },
    {
      "name": "5. Update User Profile (Protected)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alex Champion Driver\",\n  \"avatar\": \"gold-lightning-car\",\n  \"dailyGoalXp\": 75,\n  \"testDate\": \"2026-12-01T09:00:00.000Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "me"
          ]
        },
        "description": "Updates editable user attributes such as display name, avatar, daily study goal, and scheduled test date countdown."
      },
      "response": []
    },
    {
      "name": "6. Get Full Profile Screen Data (Protected)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/me/profile-screen",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "me",
            "profile-screen"
          ]
        },
        "description": "Powers the entire Profile tab screen: 4 stat tiles (Streak, XP, League, Badges), membership banner, daily quests with completion %, and achievements."
      },
      "response": []
    },
    {
      "name": "7. Forgot Password (Request Dev Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.devResetToken) {",
              "        pm.collectionVariables.set(\"resetToken\", jsonData.devResetToken);",
              "        console.log(\"✅ Auto-captured devResetToken:\", jsonData.devResetToken);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"learner@oohwheels.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/forgot-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "forgot-password"
          ]
        },
        "description": "Initiates password recovery. In dev/testing, returns devResetToken directly in response body and saves it to collection variable for step 8."
      },
      "response": []
    },
    {
      "name": "8. Reset Password with Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.token) {",
              "        pm.collectionVariables.set(\"token\", jsonData.token);",
              "        console.log(\"✅ New session token saved after password reset:\", jsonData.token);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"newPassword123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/reset-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "reset-password"
          ]
        },
        "description": "Uses the captured reset token from request #7 to set a new password and logs in automatically."
      },
      "response": []
    },
    {
      "name": "9. Logout",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        },
        "description": "Confirms logout session termination."
      },
      "response": []
    }
  ]
}
