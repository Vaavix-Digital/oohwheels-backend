{
  "info": {
    "_postman_id": "d3c2b1a0-9876-5432-10fe-dcba09876543",
    "name": "OohWheels - Learn Section API",
    "description": "Complete Postman collection for testing the OohWheels Learn Section. Powers the Duolingo-style winding road learning path, units & lesson nodes (crowned, current, locked), lesson player with 4 questions, instant feedback with heart penalties, lesson completion rewards (+20 XP, +5 Gems), and heart refills.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5020/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "lessonId",
      "value": "lesson_02",
      "type": "string"
    },
    {
      "key": "questionId",
      "value": "q_road_signs_01",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Login (Obtain Token First)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.token) {",
              "        pm.collectionVariables.set(\"token\", jsonData.token);",
              "        console.log(\"✅ Learn Auth Token auto-saved:\", jsonData.token);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emailOrPhone\": \"learner@oohwheels.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Logs in the demo learner to obtain a JWT token, automatically saving it to {{token}}."
      },
      "response": []
    },
    {
      "name": "1. Get Learning Path (Duolingo Road Map)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/learn/path",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "learn",
            "path"
          ]
        },
        "description": "Powers the entire Learn tab: Country header ('GB United Kingdom Great Britain'), Daily Goal ring (30/50 XP), Test countdown banner ('Test in 23 days'), 3 Units with winding lesson nodes (Warning Signs [crowned 👑], Give Way & Stop [current ▶️], Speed Limits [locked 🔒]), Whizzy mascot message, and Go Premium banner."
      },
      "response": []
    },
    {
      "name": "2. Get Lesson Details & Questions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/learn/lessons/{{lessonId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "learn",
            "lessons",
            "{{lessonId}}"
          ]
        },
        "description": "Starts or resumes a lesson (e.g. Give Way & Stop). Returns lesson questions, XP rewards, and current heart count."
      },
      "response": []
    },
    {
      "name": "3. Submit Lesson Answer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"questionId\": \"{{questionId}}\",\n  \"selectedAnswer\": \"B\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/learn/lessons/{{lessonId}}/answer",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "learn",
            "lessons",
            "{{lessonId}}",
            "answer"
          ]
        },
        "description": "Submits an answer during a lesson. Returns instant feedback, correct answer, explanation, and remaining hearts (deducts 1 heart on wrong answer)."
      },
      "response": []
    },
    {
      "name": "4. Complete Lesson (Award XP & Progress)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 100\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/learn/lessons/{{lessonId}}/complete",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "learn",
            "lessons",
            "{{lessonId}}",
            "complete"
          ]
        },
        "description": "Marks lesson as complete: awards +20 XP, +5 Gems, increments daily goal XP and streak."
      },
      "response": []
    },
    {
      "name": "5. Refill Hearts (50 Gems)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/learn/hearts/refill",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "learn",
            "hearts",
            "refill"
          ]
        },
        "description": "Spends 50 gems to refill hearts to maximum (5/5)."
      },
      "response": []
    }
  ]
}
